{
 "brand": "Tamburins",
 "title": "Glacial Echoes",
 "subtitle": "A glacial experience for Tamburins.",
 "line": "In the quiet hum of Tamburins, the glacier speaks through scent and stillness.",
 "quote": "Where beauty melts, time slows down.",
 "synopsis": "You enter through monolithic pillars, finding yourself instantly suspended in a field of cold, diffused light. At the center, the Melting ice block monolith slowly wanes, casting shifting shadows upon the polished concrete. You drift through the space, where every corner offers a moment of reflection and discovery. As the scent of the glacier surrounds you, time seems to dissolve along with the ice.",
 "keywords": [
  "ephemeral silence",
  "glacial touch",
  "sensory resonance"
 ],
 "why": [
  {
   "t": "Entering the frost",
   "d": "A pair of threshold objects (Monolithic ice pillars) stands 0.9-2.7 m inside the door, with a hanging screen (Translucent hanging screen) between them; the route slips through a 1.1 m gap. The threshold creates a deliberate pause, marking the transition from the bustling city into the serene, chilled atmosphere of the store."
  },
  {
   "t": "The melting core",
   "d": "The hero (Melting ice block monolith) stands alone in an empty 5 x 6 m area (Central void); the route circles it and never comes closer than 2.7 m. The central monolith acts as the heart of the space, drawing your eye with its delicate, persistent transformation."
  },
  {
   "t": "Peripheral discovery",
   "d": "Four product stations (Skincare discovery stations) sit at the outer corners, outside the loop, so you turn away from the hero to reach them. These peripheral stations invite you to explore the collection, creating a rhythmic journey between the central hero and the individual product experiences."
  },
  {
   "t": "Final surrender",
   "d": "The pay desk (Minimal transaction counter) closes the loop at the back wall. The back-positioned desk offers a final, grounded interaction, completing the loop of your journey."
  }
 ],
