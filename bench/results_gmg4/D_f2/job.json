{
 "brand": "Gentle Monster",
 "title": "HARBOR SHADOWS: THE POP-UP",
 "subtitle": "A transient collection in a harbor’s hold.",
 "line": "A desolate harbor warehouse where the rhythmic sweep of a lighthouse beam illuminates the cargo of time.",
 "quote": "Memory is a beacon that cuts through the fog of the present.",
 "synopsis": "You step into the damp, echoing shell of a warehouse lost to the sea. Inside the central chamber, the Drifting Product Plinths emerge from the dense mist, holding artifacts as if they were salvaged cargo. A flickering warmth glides over the surfaces, mimicking the lighthouse that guides ghosts home. Here, the boundary between storage and sanctuary dissolves in the fog.",
 "keywords": [
  "industrial decay",
  "maritime isolation",
  "ghost light"
 ],
 "why": [
  {
   "t": "A Warehouse Sanctuary",
   "d": "A walled chamber (Warehouse Walls), 11 x 8 m, stands inside the room; you enter it through a 1.8 m opening in its side. The enclosing walls create a sense of being lost at sea within a confined industrial space."
  },
  {
   "t": "Treasures in the Mist",
   "d": "Three low monoliths (Drifting Product Plinths) inside it carry the product at 0.9-1.4 m high. The low plinths make you lean in close, as if examining treasures washed up by the tide."
  },
  {
   "t": "Architecture of Force",
   "d": "Two blocks (Piercing Rusty Beams) break through the chamber walls on opposite sides. These heavy protrusions puncture the space, suggesting the relentless force of the harbor environment."
  },
  {
   "t": "The Outer Rim",
   "d": "The pay desk (Harbor Cash Desk) and the fitting room (Fitting Block) stay outside the chamber. Keeping the transaction and fitting processes external separates the sacred act of viewing from the routine."
  }
 ],
