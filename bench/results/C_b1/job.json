{
 "brand": "Gentle Monster",
 "title": "Threshold of the Rainy Night",
 "subtitle": "A sensory immersion into the stillness of a storm-cleansed sanctuary.",
 "line": "Step through a narrow aperture into a mirrored chamber where the rhythmic echoes of rain dissolve into the cold, sharp scent of wet stone and earth.",
 "synopsis": "As you cross the threshold, the cacophony of the city vanishes, replaced by the soft, ambient glow reflecting off polished concrete surfaces. You navigate between monolithic black stones that hold fragrances atop their damp, porous peaks, grounding you in the heart of the storm. Piercing the infinite mirror walls, raw strata clay elements suggest a world eroding beneath the surface. You finally retreat to the charcoal plinth or the secluded lime plaster alcove, where the lingering scent of rain becomes your own.",
 "keywords": [
  "Olfactory Sanctuary",
  "Atmospheric Minimalist",
  "Liminal Space"
 ],
 "quote": "In the silence after the rain, the scent of the earth reveals the truth of the moment.",
 "why": [
  {
   "t": "Infinite Mirrored Threshold",
   "d": "A chamber of infinite reflection walls, 11 x 8 m, stands inside the room; you enter it through a 1.8 m opening in its side. The reflective walls create an illusion of endless space that isolates you from the external environment."
  },
  {
   "t": "Monolith Product Display",
   "d": "Three monolith water feature objects inside the chamber carry the product at 0.9-1.4 m high. The black stone pedestals elevate the fragrance to eye level, turning the act of smelling into a ritualistic encounter."
  },
  {
   "t": "Eroded Earth Intersections",
   "d": "Two eroded earth element objects break through the chamber walls on opposite sides. The raw clay elements breaking through the walls provide a tactile contrast to the polished, futuristic surfaces."
  },
  {
   "t": "Exterior Service Zones",
   "d": "The charcoal service plinth and the secluded alcove stay outside the chamber. The charcoal plinth and lime alcove offer a grounded, physical space for you to conclude your sensory journey."
  }
 ],
