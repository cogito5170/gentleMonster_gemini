{
 "brand": "Gentle Monster",
 "title": "The Drained Pool",
 "subtitle": "Water left, light stayed",
 "line": "You walk down the ladder of a 1970s pool that has no water, only light that still moves like it.",
 "synopsis": "You go down four tiled steps into a swimming pool that was drained fifty years ago. The white gloss tiles are dry, but the ceiling throws a slow moving caustic light across them, so the floor still ripples. In the middle a swimmer's head rises out of the tiles, eyes closed, as if surfacing for air. Frames sit on low lane plinths at the four corners of the basin, and you swim past them on foot toward the mirrored deep end.",
 "keywords": [
  "Absent water",
  "Surfacing",
  "Lanes"
 ],
 "quote": "The water is gone. The light remembers it.",
 "why": [
  {
   "t": "You enter by going down",
   "d": "The route drops down the pool steps 2.5 m inside the door before it reaches the basin floor."
  },
  {
   "t": "The swimmer is the deep point",
   "d": "The head stands alone in the 13 x 9 m drained basin; the route loops around it at more than a metre."
  },
  {
   "t": "Lanes hold the product",
   "d": "Four lane plinths sit at the basin's corners, outside the loop, so trying frames means leaving the swimmer's orbit."
  },
  {
   "t": "The deep end is a mirror",
   "d": "A 13 m mirror wall closes the basin at the back, doubling the light and the tiles."
  }
 ],
