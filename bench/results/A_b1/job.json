{
 "brand": "Gentle Monster",
 "title": "The Dry Threshold",
 "subtitle": "Where the rain is switched off",
 "line": "A rainy night in Seongsu ends at a curtain of steel rain, and the room behind it is silent.",
 "synopsis": "You come in out of the rain and the sound stops at a curtain of still steel cables, hung like rain that forgot to fall. Behind it the floor is wet black stone and the only movement is a round black pool, its surface rippling under a low luminous ceiling. Four dark plinths stand at the edge of the light, each holding a single pair of frames like something left on a windowsill. You circle the pool slowly, dry for the first time tonight, and the frames are the last thing you collect before the desk.",
 "keywords": [
  "Threshold",
  "Held rain",
  "Silence"
 ],
 "quote": "The city keeps raining. Inside, only the light is wet.",
 "why": [
  {
   "t": "Rain is a wall you pass through",
   "d": "Two cable curtains hang 3.4 m inside the door with a 0.8 m dry gap between them; the street sound ends there."
  },
  {
   "t": "The pool is the only motion",
   "d": "A 2 m black basin sits alone under the luminous ceiling in a 10 x 7 m stone field; the route circles it and never touches it."
  },
  {
   "t": "Frames wait at the edge of the light",
   "d": "Four plinths sit outside the loop at the field's corners, so you step out of the light to try a pair."
  },
  {
   "t": "The desk closes the walk",
   "d": "The pay desk is the far wall; the loop ends facing it, with the rain behind you."
  }
 ],
