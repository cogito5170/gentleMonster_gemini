{
 "brand": "Gentle Monster",
 "title": "Orbital Hangar 01",
 "subtitle": "A zero-gravity retail experience for the celestial traveler",
 "line": "You drift through a clinical hangar where weightless eyewear floats within a magnetic field of polished aluminium and ethereal light.",
 "synopsis": "You enter the space through twin aluminium pillars that act as an airlock, forcing you to pass through a shimmering steel cable curtain. Once inside the mineral-white vacuum, you navigate a circular path around a central array where eyewear levitates in defiance of gravity. You turn away from this magnetic core to inspect individual pieces at glass observation ports positioned at the outer corners. Finally, your journey concludes at a polished concrete manifest station that anchors the experience against the back wall.",
 "keywords": [
  "Zero-gravity",
  "Clinical",
  "Futuristic"
 ],
 "quote": "In the absence of weight, vision becomes the only true force of attraction.",
 "why": [
  {
   "t": "Airlock Threshold",
   "d": "A pair of threshold objects (Orbital airlock pillars) stands 1.0-3.0 m inside the door, with a hanging screen (Magnetic field curtain) between them; the route slips through a 1.9 m gap. The narrow gap between aluminium pillars forces you to transition from the mundane exterior into the controlled environment of the hangar."
  },
  {
   "t": "Magnetic Vacuum",
   "d": "The hero (Levitating magnetic eyewear array) stands alone in an empty 8 x 7 m area (Zero gravity vacuum); the route circles it and never comes closer than 3.3 m. The wide clearance around the levitating display ensures you maintain a respectful, observational distance from the floating eyewear."
  },
  {
   "t": "Observation Ports",
   "d": "Four product stations (Product observation ports) sit at the outer corners, outside the loop, so you turn away from the hero to reach them. Placing the stations outside the main loop encourages you to pause your momentum and engage in focused, intimate inspection of the product."
  },
  {
   "t": "Manifest Station",
   "d": "The pay desk (Flight manifest station) closes the loop at the back wall. The solid concrete desk provides a tactile, grounded conclusion to your orbital traversal before you exit the station."
  }
 ],
