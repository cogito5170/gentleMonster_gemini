 ],
 "why": [
  {
   "t": "They filter the noisy exterior world, preparing",
   "d": "A pair of threshold objects (Basalt Threshold Pillars) stands 1.0-3.0 m inside the door, with a hanging screen (Rain Curtain) between them; the route slips through a 1.9 m gap. They filter the noisy exterior world, preparing you to enter a serene interior."
  },
  {
   "t": "It commands your attention from afar, anchoring",
   "d": "The hero (Wet Obsidian Monolith) stands alone in an empty 8 x 7 m area (Empty Reflection Void); the route circles it and never comes closer than 3.3 m. It commands your attention from afar, anchoring the vast emptiness of the room."
  },
  {
   "t": "They invite you to pause and examine the",
   "d": "Four product stations (Eyewear Stations) sit at the outer corners, outside the loop, so you turn away from the hero to reach them. They invite you to pause and examine the eyewear in intimate corners away from the central void."
  },
  {
   "t": "It completes your circular journey through the",
   "d": "The pay desk (Monolith Pay Desk) closes the loop at the back wall. It completes your circular journey through the dark gallery before you step back out."
  }
 ],
