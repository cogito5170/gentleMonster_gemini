{
 "brand": "Gentle Monster",
 "title": "The Threshold of Rain",
 "subtitle": "A sanctuary where the storm meets the stone.",
 "line": "The heavy Seongsu air dissolves into the quiet, cool suspension of an eternal, rain-washed night.",
 "quote": "The threshold is not a door, but a moment of silence in the city's pulse.",
 "synopsis": "You step out of the Seongsu rain and into a cool, concrete threshold where the urban roar instantly fades. Within this darkened enclosure, your gaze is drawn to three obsidian monoliths that rise from the floor like still, rain-slicked stones. As you move between these dark volumes, the luminous overhead light captures the essence of a storm paused in time. You wander through this obsidian silence until the path leads you gently back out to the city.",
 "keywords": [
  "rainy threshold",
  "obsidian silence",
  "luminous suspension"
 ],
 "why": [
  {
   "t": "The walled chamber acts as a psychological",
   "d": "A walled chamber (reflective night perimeter), 11 x 8 m, stands inside the room; you enter it through a 1.8 m opening in its side. The walled chamber acts as a psychological buffer, separating the chaotic street from the store's interior silence."
  },
  {
   "t": "The obsidian monoliths anchor the space",
   "d": "Three low monoliths (obsidian monoliths) inside it carry the product at 0.9-1.4 m high. The obsidian monoliths anchor the space, grounding the products as if they were geological finds within a quiet cave."
  },
  {
   "t": "The piercing rocks disrupt the rigid geometry",
   "d": "Two blocks (shattering walls) break through the chamber walls on opposite sides. The piercing rocks disrupt the rigid geometry of the walls, suggesting a force that has broken through the stillness of the night."
  },
  {
   "t": "The placement of the pay desk and fitting room",
   "d": "The pay desk (stone payment desk) and the fitting room (fitting corner) stay outside the chamber. The placement of the pay desk and fitting room outside the chamber allows for a seamless transition from the curated experience back to reality."
  }
 ],
