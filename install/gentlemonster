#!/bin/sh
# gentlemonster: runs the private Gemini CLI 0.60.0 (under ~/.gentlemonster) with gemini-3.1-flash-lite.
# CLI 0.61+ maps gemini-3.1-flash-lite to gemini-3.5-flash-lite (README, H2), so the version is checked before every start.
# Other arguments pass through; management commands (mcp, extensions, skills, hooks, gemma) take no model.
# The user's own `gemini` is never touched.
G="$HOME/.gentlemonster/cli/node_modules/.bin/gemini"
V=$("$G" --version 2>/dev/null | tr -d '[:space:]')
if [ "$V" != "0.60.0" ]; then
  echo "gentlemonster: the private Gemini CLI is ${V:-missing}, not 0.60.0 -- run: npm install --prefix \"\$HOME/.gentlemonster/cli\" @google/gemini-cli@0.60.0"
  exit 1
fi
if [ ! -f "$HOME/.gemini/extensions/gentlemonster/gemini-extension.json" ]; then
  echo "gentlemonster: the extension is not installed -- paste the install block from USAGE.md again"
  exit 1
fi
case "$1" in
  mcp|extensions|extension|skills|skill|hooks|hook|gemma) exec "$G" "$@" ;;
esac
exec "$G" -m gemini-3.1-flash-lite "$@"
